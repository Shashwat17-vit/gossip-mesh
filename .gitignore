# Private keys live here. Never commit them.
.gossipmesh/
.gossipmesh-*/
*.key

# Built binaries. The ~ file is what Go leaves behind on Windows when it
# rebuilds a binary that is currently running.
/gossipmesh
*.exe
*.exe~

# Raw screen recordings. Only the compressed demo in docs/ belongs in git.
*.mp4
!docs/demo.mp4

# Personal working notes, not for the public repo.
NOTES.md
/scratch/
